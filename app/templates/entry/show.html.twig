{% extends 'base.html.twig' %}

{% block title %}{{ entry.title }} - Veille perso{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <h1>{{ entry.title }}</h1>
            <p>{{ entry.finalMediaType.label() }} · {{ entry.status.label() }} · intérêt {{ entry.interestLevel }}/5</p>
        </div>
        <div class="actions">
            <a class="button" href="{{ path('app_entry_edit', {id: entry.id}) }}">Modifier</a>
            <form method="post" action="{{ path('app_entry_detect_tags', {id: entry.id}) }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('detect_entry_tags_' ~ entry.id) }}">
                <button class="button button-secondary">Recalculer les tags</button>
            </form>
            <form method="post" action="{{ path('app_entry_analyze', {id: entry.id}) }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('analyze_entry_' ~ entry.id) }}">
                <button class="button button-secondary">Relancer l'analyse</button>
            </form>
            {% if entry.review %}
                <a class="button button-secondary" href="{{ path('app_review_show', {id: entry.review.id}) }}">Voir la fiche</a>
                <a class="button button-secondary" href="{{ path('app_review_edit', {id: entry.review.id}) }}">Modifier la fiche</a>
            {% else %}
                <a class="button button-secondary" href="{{ path('app_review_new', {entry: entry.id}) }}">Créer une fiche</a>
            {% endif %}
        </div>
    </section>

    <section class="content-block">
        <h2>Aide Analyse</h2>
        <p>La decision finale combine media, source, tags, categories RSS, pertinence et bruit editorial. Les corrections manuelles sont tracees et protegent les choix metier explicites.</p>
    </section>

    <dl class="details">
        <dt>Source</dt>
        <dd><a href="{{ path('app_source_show', {id: entry.source.id}) }}">{{ entry.source.name }}</a></dd>
        <dt>Auteur / studio</dt>
        <dd>{{ entry.authorOrStudio|default('Non renseigné') }}</dd>
        <dt>URL originale</dt>
        <dd>
            {% if entry.originalUrl %}
                <a href="{{ entry.originalUrl }}" rel="noreferrer">{{ entry.originalUrl }}</a>
            {% else %}
                <span class="muted">Non renseignée</span>
            {% endif %}
        </dd>
        <dt>Tags</dt>
        <dd>
            {% if entry.personalTags is empty %}
                <span class="muted">Aucun tag</span>
            {% else %}
                {{ entry.personalTags|join(', ') }}
            {% endif %}
        </dd>
        <dt>Tags détectés</dt>
        <dd>
            {% if entry.detectedTags is empty %}
                <span class="muted">Aucun tag détecté</span>
            {% else %}
                {% for tag in entry.detectedTags %}
                    <span class="badge badge-muted">{{ tag }}</span>
                {% endfor %}
            {% endif %}
        </dd>
        <dt>Média final</dt>
        <dd>
            <span class="badge {{ entry.finalMediaType.value == 'other' ? 'badge-muted' : '' }}">{{ entry.finalMediaType.label() }}</span>
            <span class="score">Origine {{ entry.mediaTypeOrigin|default('unknown') }}</span>
            {% if entry.mediaDetectionConfidence is not null %}
                <span class="score">Confiance {{ entry.mediaDetectionConfidence }}/100</span>
            {% endif %}
        </dd>
        <dt>Média détecté</dt>
        <dd>
            {% if entry.detectedMediaType %}
                <span class="badge {{ entry.detectedMediaType.value == 'other' ? 'badge-muted' : '' }}">{{ entry.detectedMediaType.label() }}</span>
            {% else %}
                <span class="badge badge-muted">Non détecté</span>
            {% endif %}
            <span class="score">Stocké final {{ entry.mediaType.label() }}</span>
        </dd>
        <dt>Catégories RSS</dt>
        <dd>
            {% set rss_categories = entry.rawPayload.categories|default([]) %}
            {% if rss_categories is empty %}
                <span class="muted">Aucune catégorie RSS enregistrée</span>
            {% else %}
                {% for category in rss_categories %}
                    <span class="badge badge-muted">{{ category }}</span>
                {% endfor %}
            {% endif %}
        </dd>
        <dt>Repéré le</dt>
        <dd>{{ entry.spottedAt|date('d/m/Y H:i') }}</dd>
        <dt>Publié le</dt>
        <dd>{{ entry.publishedAt ? entry.publishedAt|date('d/m/Y H:i') : 'Non renseigné' }}</dd>
        <dt>Importé le</dt>
        <dd>{{ entry.importedAt ? entry.importedAt|date('d/m/Y H:i') : 'Saisie manuelle' }}</dd>
        <dt>ID externe</dt>
        <dd>{{ entry.externalId|default('Non renseigné') }}</dd>
        <dt>URL canonique</dt>
        <dd>
            {% if entry.canonicalUrl %}
                <a href="{{ entry.canonicalUrl }}" rel="noreferrer">{{ entry.canonicalUrl }}</a>
            {% else %}
                <span class="muted">Non renseignée</span>
            {% endif %}
        </dd>
        <dt>Hash source</dt>
        <dd>{{ entry.sourceHash|default('Non renseigné') }}</dd>
        <dt>Décision</dt>
        <dd>
            {% if entry.decision %}
                <span class="badge badge-decision-{{ entry.decision.value }}">{{ entry.decision.label() }}</span>
                <span class="score">Pertinence {{ entry.relevanceScore ?? 0 }}/100</span>
            {% else %}
                <span class="badge badge-muted">Non analysée</span>
            {% endif %}
        </dd>
        <dt>Scores détaillés</dt>
        <dd>
            <span class="score">Thématique {{ entry.thematicScore ?? 0 }}/100</span>
            <span class="score">Qualité {{ entry.editorialQualityScore ?? 0 }}/100</span>
            <span class="score">Langue {{ entry.analysisLanguage|default('n/a')|upper }}</span>
        </dd>
        <dt>Signaux d'analyse</dt>
        <dd>{{ entry.analysisSignals is empty ? 'Aucun' : entry.analysisSignals|join(', ') }}</dd>
        <dt>Putaclic</dt>
        <dd>
            {% if entry.clickbaitLevel %}
                <span class="badge badge-clickbait-{{ entry.clickbaitLevel.value }}">{{ entry.clickbaitLevel.label() }}</span>
                <span class="score">{{ entry.clickbaitScore ?? 0 }}/100</span>
            {% else %}
                <span class="muted">Non analysé</span>
            {% endif %}
        </dd>
        <dt>Raison d'analyse</dt>
        <dd>{{ entry.decisionReason|default('Aucune raison enregistrée') }}</dd>
        <dt>Mots-clés positifs</dt>
        <dd>{{ entry.matchedPositiveKeywords is empty ? 'Aucun' : entry.matchedPositiveKeywords|join(', ') }}</dd>
        <dt>Mots-clés négatifs</dt>
        <dd>{{ entry.matchedNegativeKeywords is empty ? 'Aucun' : entry.matchedNegativeKeywords|join(', ') }}</dd>
        <dt>Signaux putaclic</dt>
        <dd>{{ entry.clickbaitSignals is empty ? 'Aucun' : entry.clickbaitSignals|join(', ') }}</dd>
        <dt>Analyse</dt>
        <dd>
            {{ entry.analysisStatus.label() }}{% if entry.analysisVersion %} · {{ entry.analysisVersion }}{% endif %}
            {% if entry.analyzedAt %} · {{ entry.analyzedAt|date('d/m/Y H:i') }}{% endif %}
        </dd>
        <dt>Analyse IA</dt>
        <dd>
            {% if entry.aiAnalyzedAt %}
                {{ entry.aiModel|default('Modèle non renseigné') }} · {{ entry.aiAnalyzedAt|date('d/m/Y H:i') }}
            {% else %}
                <span class="muted">Non utilisée</span>
            {% endif %}
        </dd>
    </dl>

    <section class="section-block correction-panel">
        <div class="section-title">
            <div>
                <h2>Corrections manuelles</h2>
                <p class="muted">Ces corrections sont tracees et protegent les choix manuels des promotions automatiques.</p>
            </div>
        </div>

        <div class="correction-grid">
            <form method="post" action="{{ path('app_entry_correct_media', {id: entry.id}) }}" class="compact-form">
                <input type="hidden" name="_token" value="{{ csrf_token('correct_entry_media_' ~ entry.id) }}">
                <div>
                    <label for="correct-media">Media final</label>
                    <select id="correct-media" name="mediaType">
                        {% for media_type in media_types %}
                            <option value="{{ media_type.value }}" {{ entry.mediaType.value == media_type.value ? 'selected' : '' }}>{{ media_type.label() }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="correct-media-reason">Raison</label>
                    <input id="correct-media-reason" name="reason" placeholder="ex: categorie RSS fiable">
                </div>
                <button class="button">Corriger le media</button>
            </form>

            <form method="post" action="{{ path('app_entry_correct_decision', {id: entry.id}) }}" class="compact-form">
                <input type="hidden" name="_token" value="{{ csrf_token('correct_entry_decision_' ~ entry.id) }}">
                <div>
                    <label for="correct-decision">Decision</label>
                    <select id="correct-decision" name="decision">
                        {% for decision in decisions %}
                            <option value="{{ decision.value }}" {{ entry.decision and entry.decision.value == decision.value ? 'selected' : '' }}>{{ decision.label() }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="correct-decision-reason">Raison</label>
                    <input id="correct-decision-reason" name="reason" placeholder="ex: faux ignored">
                </div>
                <button class="button">Corriger la decision</button>
            </form>

            <form method="post" action="{{ path('app_entry_correct_detected_tags', {id: entry.id}) }}" class="compact-form compact-form-wide">
                <input type="hidden" name="_token" value="{{ csrf_token('correct_entry_detected_tags_' ~ entry.id) }}">
                <div>
                    <label for="correct-tags">Tags detectes</label>
                    <textarea id="correct-tags" name="detectedTags" rows="3">{{ entry.detectedTags|join(', ') }}</textarea>
                    <small>Liste separee par des virgules. Supprimer un tag ici revient a le masquer pour cette Entry.</small>
                </div>
                <div>
                    <label for="correct-tags-reason">Raison</label>
                    <input id="correct-tags-reason" name="reason" placeholder="ex: tag trop vague">
                </div>
                <button class="button">Corriger les tags</button>
            </form>
        </div>
    </section>

    <section class="section-block">
        <div class="section-title">
            <h2>Contenu brut</h2>
        </div>
        <div class="content-block">{{ entry.rawContent|default('Aucun contenu brut')|nl2br }}</div>
    </section>

    <div class="actions">
        <a class="button button-secondary" href="{{ path('app_entry_index') }}">Retour</a>
        {{ include('entry/_delete_form.html.twig') }}
    </div>
{% endblock %}
