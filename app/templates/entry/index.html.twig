{% extends 'base.html.twig' %}

{% block title %}Entrees - Veille perso{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <h1>Entrees</h1>
            <p>Contenus bruts reperes avant synthese personnelle.</p>
        </div>
        <div class="actions">
            <a class="button button-secondary" href="{{ path('app_entry_index', {decision: 'maybe_relevant', sort: 'imported_desc'}) }}">A verifier</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {mediaType: 'other'}) }}">Medias other</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {clickbaitLevel: 'suspicious', sort: 'imported_desc'}) }}">Putaclic suspect</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {mediaType: 'book', detectedTag: 'sf', sort: 'relevance_desc'}) }}">Livres SFF</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {mediaType: 'video_game', sort: 'interest_desc'}) }}">Jeux video</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {mediaType: 'bd', sort: 'interest_desc'}) }}">BD</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {mediaType: 'manga', sort: 'interest_desc'}) }}">Manga</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {mediaType: 'comics', sort: 'interest_desc'}) }}">Comics</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {mediaType: 'ttrpg', sort: 'interest_desc'}) }}">JDR</a>
            <a class="button button-secondary" href="{{ path('app_entry_index', {mediaType: 'figurines', sort: 'interest_desc'}) }}">Figurines</a>
            <a class="button" href="{{ path('app_entry_new') }}">Nouvelle entree</a>
        </div>
    </section>

    <form method="get" class="filter-form">
        <div>
            <label for="q">Recherche</label>
            <input id="q" type="search" name="q" value="{{ filters.q }}" placeholder="Titre, contenu, tags, source...">
        </div>
        <div>
            <label for="source">Source</label>
            <select id="source" name="source">
                <option value="">Toutes</option>
                {% for source in sources %}
                    <option value="{{ source.id }}" {{ filters.source == source.id ? 'selected' : '' }}>{{ source.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="mediaType">Media</label>
            <select id="mediaType" name="mediaType">
                <option value="">Tous</option>
                {% for media_type in media_types %}
                    <option value="{{ media_type.value }}" {{ filters.mediaType == media_type.value ? 'selected' : '' }}>{{ media_type.label() }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="detectedMediaType">Media detecte</label>
            <select id="detectedMediaType" name="detectedMediaType">
                <option value="">Tous</option>
                {% for media_type in media_types %}
                    <option value="{{ media_type.value }}" {{ filters.detectedMediaType == media_type.value ? 'selected' : '' }}>{{ media_type.label() }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="mediaTypeOrigin">Origine media</label>
            <select id="mediaTypeOrigin" name="mediaTypeOrigin">
                <option value="">Toutes</option>
                {% for origin in media_type_origins %}
                    <option value="{{ origin }}" {{ filters.mediaTypeOrigin == origin ? 'selected' : '' }}>{{ origin }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="status">Statut</label>
            <select id="status" name="status">
                <option value="">Tous</option>
                {% for status in statuses %}
                    <option value="{{ status.value }}" {{ filters.status == status.value ? 'selected' : '' }}>{{ status.label() }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="interestLevel">Interet</label>
            <select id="interestLevel" name="interestLevel">
                <option value="">Tous</option>
                {% for level in 0..5 %}
                    <option value="{{ level }}" {{ filters.interestLevel is same as(level) ? 'selected' : '' }}>{{ level }}/5</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="reviewState">Fiche</label>
            <select id="reviewState" name="reviewState">
                <option value="">Toutes</option>
                <option value="with" {{ filters.reviewState == 'with' ? 'selected' : '' }}>Avec fiche</option>
                <option value="without" {{ filters.reviewState == 'without' ? 'selected' : '' }}>Sans fiche</option>
            </select>
        </div>
        <div>
            <label for="synthesisState">Synthese</label>
            <select id="synthesisState" name="synthesisState">
                <option value="">Toutes</option>
                <option value="with" {{ filters.synthesisState == 'with' ? 'selected' : '' }}>Deja synthetisee</option>
                <option value="without" {{ filters.synthesisState == 'without' ? 'selected' : '' }}>Jamais synthetisee</option>
            </select>
        </div>
        <div>
            <label for="decision">Decision</label>
            <select id="decision" name="decision">
                <option value="">Toutes</option>
                {% for decision in decisions %}
                    <option value="{{ decision.value }}" {{ filters.decision == decision.value ? 'selected' : '' }}>{{ decision.label() }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="clickbaitLevel">Putaclic</label>
            <select id="clickbaitLevel" name="clickbaitLevel">
                <option value="">Tous</option>
                {% for level in clickbait_levels %}
                    <option value="{{ level.value }}" {{ filters.clickbaitLevel == level.value ? 'selected' : '' }}>{{ level.label() }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="keyword">Mot-cle analyse</label>
            <input id="keyword" type="search" name="keyword" value="{{ filters.keyword }}" placeholder="sf, fantasy, rumeur...">
        </div>
        <div>
            <label for="detectedTag">Tag detecte</label>
            <input id="detectedTag" type="search" name="detectedTag" value="{{ filters.detectedTag }}" placeholder="battlefield, fps, sf...">
        </div>
        <div>
            <label for="rssCategory">Categorie RSS</label>
            <input id="rssCategory" type="search" name="rssCategory" value="{{ filters.rssCategory }}" placeholder="Romans VF, Space Opera...">
        </div>
        <div>
            <label for="analysisLanguage">Langue</label>
            <select id="analysisLanguage" name="analysisLanguage">
                <option value="">Toutes</option>
                <option value="fr" {{ filters.analysisLanguage == 'fr' ? 'selected' : '' }}>FR</option>
                <option value="en" {{ filters.analysisLanguage == 'en' ? 'selected' : '' }}>EN</option>
                <option value="mixed" {{ filters.analysisLanguage == 'mixed' ? 'selected' : '' }}>Mixte</option>
                <option value="unknown" {{ filters.analysisLanguage == 'unknown' ? 'selected' : '' }}>Inconnue</option>
            </select>
        </div>
        <div>
            <label for="sort">Tri</label>
            <select id="sort" name="sort">
                <option value="">Creation recente</option>
                <option value="published_desc" {{ filters.sort == 'published_desc' ? 'selected' : '' }}>Publication recente</option>
                <option value="published_asc" {{ filters.sort == 'published_asc' ? 'selected' : '' }}>Publication ancienne</option>
                <option value="imported_desc" {{ filters.sort == 'imported_desc' ? 'selected' : '' }}>Import recent</option>
                <option value="imported_asc" {{ filters.sort == 'imported_asc' ? 'selected' : '' }}>Import ancien</option>
                <option value="relevance_desc" {{ filters.sort == 'relevance_desc' ? 'selected' : '' }}>Pertinence forte</option>
                <option value="relevance_asc" {{ filters.sort == 'relevance_asc' ? 'selected' : '' }}>Pertinence faible</option>
                <option value="clickbait_desc" {{ filters.sort == 'clickbait_desc' ? 'selected' : '' }}>Putaclic fort</option>
                <option value="clickbait_asc" {{ filters.sort == 'clickbait_asc' ? 'selected' : '' }}>Putaclic faible</option>
                <option value="interest_desc" {{ filters.sort == 'interest_desc' ? 'selected' : '' }}>Interet fort</option>
                <option value="interest_asc" {{ filters.sort == 'interest_asc' ? 'selected' : '' }}>Interet faible</option>
                <option value="analyzed_desc" {{ filters.sort == 'analyzed_desc' ? 'selected' : '' }}>Analyse recente</option>
                <option value="analyzed_asc" {{ filters.sort == 'analyzed_asc' ? 'selected' : '' }}>Analyse ancienne</option>
            </select>
        </div>
        <div>
            <label for="view">Affichage</label>
            <select id="view" name="view">
                <option value="default" {{ filters.view == 'default' ? 'selected' : '' }}>Detaille</option>
                <option value="compact" {{ filters.view == 'compact' ? 'selected' : '' }}>Compact</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="button">Filtrer</button>
            <a class="button button-secondary" href="{{ path('app_entry_index') }}">Reinitialiser</a>
        </div>
    </form>

    {{ include('partials/_filter_status.html.twig') }}

    <div class="actions action-strip">
        <form method="post" action="{{ path('app_entry_reanalyze_filtered', app.request.query.all) }}" class="inline-form" onsubmit="return confirm('Re-analyser toutes les entrees du filtre courant ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('reanalyze_filtered_entries') }}">
            <button class="button button-secondary">Re-analyser le filtre courant</button>
        </form>
        <form method="post" action="{{ path('app_entry_detect_tags_filtered', app.request.query.all) }}" class="inline-form" onsubmit="return confirm('Recalculer les tags des entrees du filtre courant ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('detect_tags_filtered_entries') }}">
            <button class="button button-secondary">Detecter les tags du filtre</button>
        </form>
    </div>

    {% if entries is empty %}
        <div class="empty">
            <strong>Aucune entree trouvee.</strong>
            <p>Ajuste les filtres ou cree une entree manuelle.</p>
            <div class="actions">
                <a class="button button-secondary" href="{{ path('app_entry_index') }}">Reinitialiser</a>
                <a class="button" href="{{ path('app_entry_new') }}">Nouvelle entree</a>
            </div>
        </div>
    {% else %}
        <table class="entry-table {{ filters.view == 'compact' ? 'entry-table-compact' : '' }}">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Media</th>
                    <th>Source</th>
                    <th>Interet</th>
                    <th>Analyse</th>
                    <th>Fiche</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr>
                        <td class="entry-title-cell" data-label="Titre">
                            <a href="{{ path('app_entry_show', {id: entry.id}) }}">{{ entry.title }}</a>
                            {% if filters.view == 'compact' and entry.rawContent %}
                                <small>{{ entry.rawContent|striptags|slice(0, 140) }}{{ entry.rawContent|length > 140 ? '...' : '' }}</small>
                            {% endif %}
                        </td>
                        <td data-label="Media">
                            {{ entry.finalMediaType.label() }}
                            {% if entry.mediaTypeOrigin %}<small>{{ entry.mediaTypeOrigin }}</small>{% endif %}
                        </td>
                        <td data-label="Source">
                            {{ entry.source.name }}
                            {% set quality = source_quality[entry.source.id] ?? null %}
                            {% if quality %}
                                <span class="badge {{ quality.class }}" title="Score source {{ quality.score }} sur {{ quality.total }} entree(s) analysees">{{ quality.label }}</span>
                            {% endif %}
                        </td>
                        <td data-label="Interet">{{ entry.interestLevel }}/5</td>
                        <td data-label="Analyse">
                            {% if entry.decision %}
                                <span class="badge badge-decision-{{ entry.decision.value }}">{{ entry.decision.label() }}</span>
                                <small>{{ entry.relevanceScore ?? 0 }}/100</small>
                            {% else %}
                                <span class="badge badge-muted">A analyser</span>
                            {% endif %}
                        </td>
                        <td data-label="Fiche">
                            {% if entry.review %}
                                <span class="badge">Fichee</span>
                                {% if entry.review.draft %}<span class="badge badge-muted">Brouillon</span>{% endif %}
                                {% if entry.review.autoCreated %}<span class="badge badge-muted">Auto</span>{% endif %}
                            {% else %}
                                <span class="badge badge-muted">A ficher</span>
                            {% endif %}
                            {% if entry.lastSynthesizedAt %}
                                <span class="badge badge-muted">Synthetisee</span>
                            {% endif %}
                        </td>
                        <td class="entry-details-cell" data-label="Details">
                            <details class="entry-row-details">
                                <summary>Voir</summary>
                                <div class="entry-row-details-content">
                                    <dl class="entry-detail-grid">
                                        <div>
                                            <dt>Media detecte</dt>
                                            <dd>
                                                {% if entry.detectedMediaType %}
                                                    <span class="badge {{ entry.detectedMediaType.value == 'other' ? 'badge-muted' : '' }}">{{ entry.detectedMediaType.label() }}</span>
                                                {% else %}
                                                    <span class="badge badge-muted">Non detecte</span>
                                                {% endif %}
                                            </dd>
                                        </div>
                                        <div>
                                            <dt>Statut</dt>
                                            <dd><span class="badge">{{ entry.status.label() }}</span></dd>
                                        </div>
                                        <div>
                                            <dt>Putaclic</dt>
                                            <dd>
                                                {% if entry.clickbaitLevel %}
                                                    <span class="badge badge-clickbait-{{ entry.clickbaitLevel.value }}">{{ entry.clickbaitLevel.label() }}</span>
                                                    <small>{{ entry.clickbaitScore ?? 0 }}/100</small>
                                                {% else %}
                                                    <span class="badge badge-muted">-</span>
                                                {% endif %}
                                            </dd>
                                        </div>
                                        <div>
                                            <dt>Langue</dt>
                                            <dd>{{ entry.analysisLanguage|default('-')|upper }}</dd>
                                        </div>
                                        <div class="entry-detail-wide">
                                            <dt>Tags detectes</dt>
                                            <dd>
                                                {% if entry.detectedTags is empty %}
                                                    <span class="badge badge-muted">Aucun</span>
                                                {% else %}
                                                    {% for tag in entry.detectedTags|slice(0, 10) %}
                                                        <span class="badge badge-muted">{{ tag }}</span>
                                                    {% endfor %}
                                                {% endif %}
                                            </dd>
                                        </div>
                                        {% if entry.rawPayload.categories is defined and entry.rawPayload.categories is not empty %}
                                            <div class="entry-detail-wide">
                                                <dt>Categories RSS</dt>
                                                <dd>{{ entry.rawPayload.categories|slice(0, 8)|join(', ') }}</dd>
                                            </div>
                                        {% endif %}
                                        <div class="entry-detail-wide">
                                            <dt>Extrait</dt>
                                            <dd>
                                                {% if entry.rawContent %}
                                                    {{ entry.rawContent|striptags|slice(0, 240) }}{{ entry.rawContent|length > 240 ? '...' : '' }}
                                                {% else %}
                                                    <span class="badge badge-muted">Aucun extrait</span>
                                                {% endif %}
                                            </dd>
                                        </div>
                                    </dl>
                                    <div class="entry-row-actions">
                                        {% if entry.review %}
                                            <a class="button button-secondary" href="{{ path('app_review_edit', {id: entry.review.id}) }}">Fiche</a>
                                        {% else %}
                                            <a class="button button-secondary" href="{{ path('app_review_new', {entry: entry.id}) }}">Creer fiche</a>
                                        {% endif %}
                                        <a class="button button-secondary" href="{{ path('app_entry_edit', {id: entry.id}) }}">Modifier</a>
                                        <form method="post" action="{{ path('app_entry_mark_relevant', app.request.query.all|merge({id: entry.id})) }}" class="inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('mark_entry_relevant_' ~ entry.id) }}">
                                            <button class="button button-secondary">Pertinent</button>
                                        </form>
                                        <form method="post" action="{{ path('app_entry_mark_ignored', app.request.query.all|merge({id: entry.id})) }}" class="inline-form" onsubmit="return confirm('Marquer cette entree comme ignoree ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('mark_entry_ignored_' ~ entry.id) }}">
                                            <button class="button button-danger">Ignorer</button>
                                        </form>
                                        {{ include('entry/_delete_form.html.twig') }}
                                    </div>
                                </div>
                            </details>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {{ include('partials/_pager.html.twig', {pagination: pagination, route: 'app_entry_index', label: 'Pagination des entrees'}) }}
    {% endif %}
{% endblock %}
