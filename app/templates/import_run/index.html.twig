{% extends 'base.html.twig' %}

{% block title %}Imports - Veille perso{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <h1>Imports</h1>
            <p>Historique des imports RSS lancés manuellement.</p>
        </div>
        <form method="post" action="{{ path('app_import_run_import_sources', app.request.query.all) }}" class="inline-form" onsubmit="return confirm('Importer maintenant toutes les sources RSS actives ? Un historique sera cree pour chaque source traitee.');">
            <input type="hidden" name="_token" value="{{ csrf_token('import_sources') }}">
            <button class="button">Importer les sources RSS</button>
        </form>
    </section>

    <form method="get" class="filter-form filter-form-small">
        <div>
            <label for="source">Source</label>
            <select id="source" name="source">
                <option value="">Toutes</option>
                {% for source in sources %}
                    <option value="{{ source.id }}" {{ filters.source == source.id ? 'selected' : '' }}>{{ source.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="filter-actions">
            <button class="button">Filtrer</button>
            <a class="button button-secondary" href="{{ path('app_import_run_index') }}">Réinitialiser</a>
        </div>
    </form>

    {{ include('partials/_filter_status.html.twig') }}

    {% if runs is empty %}
        <div class="empty">
            <strong>Aucun import trouve.</strong>
            <p>Lance un import global ou retire le filtre de source.</p>
            <div class="actions">
                <a class="button button-secondary" href="{{ path('app_import_run_index') }}">Reinitialiser</a>
            </div>
        </div>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Démarré</th>
                    <th>Terminé</th>
                    <th>Source</th>
                    <th>Statut</th>
                    <th>Récupérés</th>
                    <th>Créés</th>
                    <th>Ignorés</th>
                    <th>Erreur</th>
                </tr>
            </thead>
            <tbody>
                {% for run in runs %}
                    <tr>
                        <td>{{ run.startedAt|date('d/m/Y H:i') }}</td>
                        <td>{{ run.finishedAt ? run.finishedAt|date('d/m/Y H:i') : '-' }}</td>
                        <td><a href="{{ path('app_source_show', {id: run.source.id}) }}">{{ run.source.name }}</a></td>
                        <td><span class="badge">{{ run.status.label() }}</span></td>
                        <td>{{ run.fetchedCount }}</td>
                        <td>{{ run.createdCount }}</td>
                        <td>{{ run.skippedCount }}</td>
                        <td>{{ run.errorMessage ? run.errorMessage : '-' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ include('partials/_pager.html.twig', {pagination: pagination, route: 'app_import_run_index', label: 'Pagination des imports'}) }}
    {% endif %}
{% endblock %}
