<form class="inline-form" method="post" action="{{ path('app_review_delete', app.request.query.all|merge({id: review.id})) }}" onsubmit="return confirm('Supprimer cette fiche ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
    <button class="button button-danger">Supprimer</button>
</form>
