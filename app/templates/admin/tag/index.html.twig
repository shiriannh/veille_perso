{% extends 'base.html.twig' %}

{% block title %}Tags - Admin{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <h1>{{ title|default('Tags') }}</h1>
            <p>{{ intro|default("Tags métier utilisés pour la détection, les filtres et l'enrichissement progressif.") }}</p>
        </div>
        <div class="actions">
            <a class="button button-secondary" href="{{ path('app_admin_index') }}">Admin</a>
            <a class="button button-secondary" href="{{ path('app_admin_tag_interest') }}">Tags d'intérêt</a>
            <a class="button button-secondary" href="{{ path('app_admin_tag_auto_generated') }}">À valider</a>
            <a class="button" href="{{ path('app_admin_tag_new') }}">Nouveau tag</a>
        </div>
    </section>

    {% if tags is empty %}
        <p class="empty">Aucun tag.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Slug</th>
                    <th>Langue</th>
                    <th>Média</th>
                    <th>Signaux</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for tag in tags %}
                    <tr>
                        <td>{{ tag.name }}</td>
                        <td><code>{{ tag.slug }}</code></td>
                        <td>{{ tag.language|default('-')|upper }}</td>
                        <td>{{ tag.mediaType ? tag.mediaType.name : '-' }}</td>
                        <td>
                            <span class="badge {{ tag.active ? '' : 'badge-muted' }}">{{ tag.active ? 'Actif' : 'Inactif' }}</span>
                            {% if tag.interestRelated %}<span class="badge">Intérêt</span>{% endif %}
                            {% if tag.autoGenerated %}<span class="badge badge-muted">Auto</span>{% endif %}
                            {% if tag.confidence is not null %}<span class="score">{{ tag.confidence }}/100</span>{% endif %}
                        </td>
                        <td class="table-actions">
                            <a class="button button-secondary" href="{{ path('app_admin_tag_edit', {id: tag.id}) }}">Modifier</a>
                            {% if tag.autoGenerated and not tag.active %}
                                <form method="post" action="{{ path('app_admin_tag_validate', {id: tag.id}) }}" class="inline-form" onsubmit="return confirm('Valider ce tag comme centre d’intérêt ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('validate_tag_' ~ tag.id) }}">
                                    <button class="button">Valider</button>
                                </form>
                            {% endif %}
                            {% if tag.active %}
                                <form method="post" action="{{ path('app_admin_tag_disable', {id: tag.id}) }}" class="inline-form" onsubmit="return confirm('Désactiver ce tag ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('disable_tag_' ~ tag.id) }}">
                                    <button class="button button-danger">Désactiver</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ include('partials/_pager.html.twig', {pagination: pagination, route: pager_route, label: 'Pagination des tags'}) }}
    {% endif %}
{% endblock %}
