{% extends 'base.html.twig' %}

{% block title %}Importer des sources - Veille perso{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <h1>Importer des sources</h1>
            <p>Import transactionnel : si une ligne est invalide, aucune source n'est creee.</p>
        </div>
        <div class="actions">
            <a class="button button-secondary" href="{{ path('app_source_import_csv_template') }}">Telecharger le modele CSV</a>
            <a class="button button-secondary" href="{{ path('app_source_index') }}">Retour</a>
        </div>
    </section>

    <section class="section-block">
        <h2>Aide Import CSV</h2>
        <p class="muted">La validation est transactionnelle : une seule ligne invalide annule tout l'import. Utilise la simulation pour tester un fichier avant creation.</p>
        <div class="details">
            <dt>Separateur</dt>
            <dd>Point-virgule <code>;</code></dd>
            <dt>Encodage</dt>
            <dd>UTF-8, BOM UTF-8 tolere</dd>
            <dt>En-tetes</dt>
            <dd><code>name;type;url;isActive;fetchMode;feedUrl;notes</code></dd>
            <dt>Valeurs enum</dt>
            <dd><code>type</code> : website, rss, newsletter, youtube, podcast, social, other. <code>fetchMode</code> : manual, rss.</dd>
            <dt>Booleen</dt>
            <dd><code>isActive</code> : true, false, 1, 0, oui, non, yes, no.</dd>
            <dt>Simulation</dt>
            <dd>La case de simulation lance toutes les validations sans creer de Source.</dd>
            <dt>Doublons</dt>
            <dd>Le controle peut porter sur le nom, le flux RSS, ou le couple nom + flux RSS.</dd>
        </div>
    </section>

    <section class="section-block">
        <h2>Exemple</h2>
        <pre class="code-sample"><code>name;type;url;isActive;fetchMode;feedUrl;notes
Actu SF;website;https://example.org;true;rss;https://example.org/feed.xml;Veille science-fiction
Site manuel;website;https://example.net;true;manual;;A consulter ponctuellement</code></pre>
    </section>

    {% if errors is not empty %}
        <section class="section-block">
            <h2>Erreurs detectees</h2>
            <div class="empty">
                <p>Aucune source n'a ete importee.</p>
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
                <a class="button button-secondary" href="{{ path('app_source_import_csv_error_report') }}">Telecharger le rapport</a>
            </div>
        </section>
    {% endif %}

    {{ form_start(form, {attr: {class: 'upload-form'}}) }}
        {{ form_widget(form) }}
        <div class="actions">
            <button class="button">Importer le CSV</button>
            <a class="button button-secondary" href="{{ path('app_source_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
