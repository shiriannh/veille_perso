<form class="inline-form" method="post" action="{{ path('app_source_delete', {id: source.id}) }}" onsubmit="return confirm('Supprimer cette source ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_source_' ~ source.id) }}">
    <button class="button button-danger">Supprimer</button>
</form>
