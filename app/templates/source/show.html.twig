{% extends 'base.html.twig' %}

{% block title %}{{ source.name }} - Veille perso{% endblock %}

{% block body %}
    <section class="page-heading">
        <div>
            <h1>{{ source.name }}</h1>
            <p>{{ source.type.label() }} · {{ source.fetchMode.label() }} · {{ source.active ? 'active' : 'inactive' }}</p>
        </div>
        <div class="actions">
            <a class="button" href="{{ path('app_source_edit', {id: source.id}) }}">Modifier</a>
            {% if source.fetchMode.value == 'rss' %}
                <form method="post" action="{{ path('app_source_import', {id: source.id}) }}" class="inline-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('import_source_' ~ source.id) }}">
                    <button class="button button-secondary">Importer</button>
                </form>
            {% endif %}
            <a class="button button-secondary" href="{{ path('app_source_index') }}">Retour</a>
        </div>
    </section>

    <dl class="details">
        <dt>URL</dt>
        <dd>
            {% if source.url %}
                <a href="{{ source.url }}" rel="noreferrer">{{ source.url }}</a>
            {% else %}
                <span class="muted">Non renseignée</span>
            {% endif %}
        </dd>
        <dt>Flux RSS</dt>
        <dd>
            {% if source.feedUrl %}
                <a href="{{ source.feedUrl }}" rel="noreferrer">{{ source.feedUrl }}</a>
            {% else %}
                <span class="muted">Non renseigné</span>
            {% endif %}
        </dd>
        <dt>Dernier import</dt>
        <dd>{{ source.lastFetchedAt ? source.lastFetchedAt|date('d/m/Y H:i') : 'Jamais' }}</dd>
        <dt>Dernier succès</dt>
        <dd>{{ source.lastSuccessAt ? source.lastSuccessAt|date('d/m/Y H:i') : 'Jamais' }}</dd>
        <dt>Dernière erreur</dt>
        <dd>
            {% if source.lastErrorAt %}
                {{ source.lastErrorAt|date('d/m/Y H:i') }}
                {% if source.lastErrorMessage %}
                    <br><span class="muted">{{ source.lastErrorMessage }}</span>
                {% endif %}
            {% else %}
                Aucune
            {% endif %}
        </dd>
        <dt>Notes</dt>
        <dd>{{ source.notes|default('Aucune note')|nl2br }}</dd>
        <dt>Profil de source</dt>
        <dd>{{ source.sourceProfileLabel() }} · poids {{ source.sourceWeightLabel() }}</dd>
        <dt>Créée le</dt>
        <dd>{{ source.createdAt|date('d/m/Y H:i') }}</dd>
        <dt>Mise à jour le</dt>
        <dd>{{ source.updatedAt|date('d/m/Y H:i') }}</dd>
    </dl>

    <div class="actions">
        {{ include('source/_delete_form.html.twig') }}
    </div>

    <section class="section-block">
        <div class="section-title">
            <h2>Historique d’import</h2>
            <a href="{{ path('app_import_run_index', {source: source.id}) }}">Tout voir</a>
        </div>
        {% if import_runs is empty %}
            <p class="empty">Aucun import lancé pour cette source.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Démarré</th>
                        <th>Statut</th>
                        <th>Récupérés</th>
                        <th>Créés</th>
                        <th>Ignorés</th>
                        <th>Erreur</th>
                    </tr>
                </thead>
                <tbody>
                    {% for run in import_runs %}
                        <tr>
                            <td>{{ run.startedAt|date('d/m/Y H:i') }}</td>
                            <td><span class="badge">{{ run.status.label() }}</span></td>
                            <td>{{ run.fetchedCount }}</td>
                            <td>{{ run.createdCount }}</td>
                            <td>{{ run.skippedCount }}</td>
                            <td>{{ run.errorMessage|default('-') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endblock %}
